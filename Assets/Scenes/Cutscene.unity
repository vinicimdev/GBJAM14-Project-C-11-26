--- !u!114 &349304323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 349304318}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1fa69c7692b0186e2929d2c0b524e599, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneDirector
  panes:
  - label: Shot1
    shotCamera: {fileID: 107940976}
    rig: {fileID: 0}
    state: 
    leadIn: 1
    holdOut: 1
    text: 'FINALLY! SKULL ISLAND

      MUAHAHAHAHAHAHAH >:3

      HERE IS WHERE
      THE

      PIRATE PRINCE PUT

      ALL HIS TREASURE

      TEN YEARS ME SAIL

      FOR
      THIS ROCK, BOYS!

      ...ME HAS NO BOYS.

      TALKING ALONE AGAIN

      ME
      DO THAT A LOT OwO

      THEY SAY IT IS DOOMED

      THEY SAY IT IS CURSED

      ME?
      ME DONT CARE.

      ME ONLY CARE ABOUT

      ONE THING. GOLD! >:3

'
  - label: Shot2
    shotCamera: {fileID: 1624093412}
    rig: {fileID: 0}
    state: 
    leadIn: 1
    holdOut: 1
    text: "THE CAVE IS VERY DARK\nAND VERY COLD.\n...ME IS NOT SCARED.\nME WILL SING!
      SINGING\nIS NOT SCARED! :3 \nRICH! RICH! RICH!\nOH ME! OH MY! SO RICH\nNO MAN
      CAN TEST ME\nNO SEA CAN IMPRESS ME\nME RIVER OF GOLD\nWILL NEVER EVER END!\nALL
      THE MONEY IN THE\nWORLD IS FOR ME\nBECAUSE ME IS A VERY\nWEALTHY BOY! UwU\n"
  - label: Shot3
    shotCamera: {fileID: 1643552105}
    rig: {fileID: 0}
    state: 
    leadIn: 1
    holdOut: 1
    text: 'THERE IT IS. OwO

      ALL MINE. ALL MINE.

      ME GOT IT! ME GOT IT!

      TEN
      YEARS AND ME

      GOT IT! HIHIHIIHIH

      ME IS THE BEAUTY KING

      OF
      THE SILVER SEA!

      ME LIVE LIFE LIKE A

      DREAM! ME KNOW ME

      GOT
      A BIG EGO... :3

      BUT WHY IS THAT SUCH

      A BIG DEAL THOUGH? :3

      LOOK
      AT ME. LOOK AT

      THE CHEST. JUST US.

      ...WHY IS IT WARM?'
  - label: Shot4
    shotCamera: {fileID: 232467441}
    rig: {fileID: 0}
    state: 
    leadIn: 1
    holdOut: 1
    text: "ON THE SHIP IT GOES!\nTIE IT DOWN, BOYS!\nYES, CAPTAIN! \n...THAT WAS
      ME AGAIN \nWASNT IT. >:3 \nTHEY CAN BEG AND\nTHEY CAN PLEAD BUT\nTHEY CANT
      SEE THE\nLIGHT, THATS RIGHT!\nTHE BOY WITH THE COLD\nHARD CASH IS ALWAYS\nMISTER
      RIGHT!!! :3\nME AND ME CHEST,\nGOING HOME VERY RICH\nNOTHING CAN STOP...\n...WHAT
      IS THAT\nSOUND? OwO\nTHAT IS NOT THE WIND\nTHAT IS NOT THE SEA\r\nOH NO. OH
      NO. NOOOO!"
  typewriter: {fileID: 571241707}
  textbox: {fileID: 1085418618}
  nextScene: Level
